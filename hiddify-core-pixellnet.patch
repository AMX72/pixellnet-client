 func connectedVia(group adapter.OutboundGroup) string {
-	if b, ok := group.(*balancer.Balancer); ok && b.Strategy() != balancer.StrategyLowestDelay {
+	if b, ok := group.(*balancer.Balancer); ok && !singleRoute(b) {
 		return ""
 	}
 	return groupNow(group)
 }
 
+// singleRoute reports whether a balancer sends every connection through one member, the one the
+// UI shows: lowest-delay, and PIXELLNET's «⚡ Автовыбор», a one-slot pool (v0.1.103, config/pixellnet.go).
+func singleRoute(b *balancer.Balancer) bool {
+	return b.Strategy() == balancer.StrategyLowestDelay ||
+		(b.Strategy() == balancer.StrategyPool && b.Tag() == config.OutboundURLTestTag)
+}
