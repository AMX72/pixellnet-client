diff --git a/v2/config/pixellnet.go b/v2/config/pixellnet.go
new file mode 100644
index 0000000..4138490
--- /dev/null
+++ b/v2/config/pixellnet.go
@@ -0,0 +1,108 @@
+package config
+
+// PIXELLNET (v0.1.103): fewer new connections from one user to the entry server.
+//
+// The anti-DDoS of the entry (Aeza MSK) shuts a source IP off for 5-30 min after bursts of new
+// connections (2026-11-25: TCP to every port opens, then no data; ICMP lost; UDP 443/2053 dead;
+// only AWG on UDP 8211 lives). The client made those bursts itself:
+//   - the select group started on the round-robin balancer: every app connection went to the next
+//     channel, VLESS ones (WS, XHTTP, Reality, CDN) opening a new TCP connection to the entry each
+//     time, on a different port;
+//   - the remote DNS was a group of 6 plain servers (TCP/UDP/TLS): every query a new connection
+//     through the proxy, and an empty or NXDOMAIN answer tried all six.
+// Now «⚡ Автовыбор» keeps the first working channel of those that hold one flow to the entry
+// (QUIC: Hysteria2, TUIC; then AnyTLS, which reuses its TLS sessions), the remote DNS is DoH (one
+// HTTP/2 connection for all queries) with a second DoH server as its only fallback, and the app
+// starts on «⚡ Автовыбор» (default-proxy=lowest, sent by the app).
+
+import (
+	"slices"
+	"sort"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+const (
+	// «⚡ Автовыбор» changes its channel while that one answers only for one faster by more than
+	// the larger of these (80 ms, or half the current delay); a dead one is left at once.
+	pixellnetAutoTolerance      uint16 = 80
+	pixellnetAutoToleranceRatio        = 0.5
+	// remote DNS in place of a plain udp/tcp/tls address
+	pixellnetRemoteDoH = "https://8.8.8.8/dns-query"
+)
+
+// pixellnetOneFlowFirst orders the members of «⚡ Автовыбор»: one QUIC flow per channel first
+// (Hysteria2, TUIC), then AnyTLS (its TLS sessions are reused), then the rest in the profile's
+// order (VLESS & co: a new TCP connection to the entry per app connection), WireGuard/AWG last
+// (one key per subscription: a second device on it breaks the first).
+func pixellnetOneFlowFirst(tags []string, outbounds []option.Outbound, endpoints []option.Endpoint) []string {
+	kind := make(map[string]string, len(outbounds)+len(endpoints))
+	for _, out := range outbounds {
+		kind[out.Tag] = out.Type
+	}
+	for _, end := range endpoints {
+		kind[end.Tag] = end.Type
+	}
+	rank := func(tag string) int {
+		switch kind[tag] {
+		case C.TypeHysteria2, C.TypeHysteria, C.TypeTUIC:
+			return 0
+		case C.TypeAnyTLS:
+			return 1
+		case C.TypeWireGuard, C.TypeAwg:
+			return 3
+		}
+		return 2
+	}
+	ordered := slices.Clone(tags)
+	sort.SliceStable(ordered, func(i, j int) bool { return rank(ordered[i]) < rank(ordered[j]) })
+	return ordered
+}
+
+// pixellnetAutoSelect is «⚡ Автовыбор»: a one-slot pool, which keeps the first working member in
+// the order above, takes the next working one when it dies, and moves to a faster one only past
+// the tolerance (protocol/group/balancer/h_pool.go). It replaces hiddify's lowest-delay pick,
+// which moved to whichever channel was a few ms faster, VLESS ones included.
+func pixellnetAutoSelect(tags []string, outbounds []option.Outbound, endpoints []option.Endpoint) option.Outbound {
+	return option.Outbound{
+		Type: C.TypeBalancer,
+		Tag:  OutboundURLTestTag,
+		Options: &option.BalancerOutboundOptions{
+			Outbounds:                 pixellnetOneFlowFirst(tags, outbounds, endpoints),
+			Strategy:                  "pool",
+			Pool:                      1,
+			Tolerance:                 pixellnetAutoTolerance,
+			ToleranceRatio:            pixellnetAutoToleranceRatio,
+			InterruptExistConnections: true,
+		},
+	}
+}
+
+// pixellnetRemoteDNSAddress turns a plain udp/tcp/tls remote DNS into DoH: one HTTP/2 connection
+// through the proxy carries every query, where a TCP or TLS server opened one per query.
+func pixellnetRemoteDNSAddress(address string) string {
+	for _, prefix := range []string{"udp://", "tcp://", "tls://"} {
+		if strings.HasPrefix(address, prefix) {
+			return pixellnetRemoteDoH
+		}
+	}
+	return address
+}
+
+// pixellnetRemoteGroup is the remote DNS group for a DoH address: the selected server, then the
+// DoH fallback (another provider). An empty or NXDOMAIN answer tries the next member (see
+// hiddify-sing-box dns/transport/group.go), so two members cost at most two queries, both on
+// kept-alive connections, where the six plain members cost six new connections.
+func pixellnetRemoteGroup(primary, fallback option.DNSServerOptions) *option.DNSServerOptions {
+	return &option.DNSServerOptions{
+		Tag:  DNSMultiRemoteTag,
+		Type: C.DNSTypeGroup,
+		Options: &option.GroupDNSServerOptions{
+			Servers:      []string{primary.Tag, fallback.Tag},
+			Mode:         C.DNSGroupModeSequential,
+			IgnoreRanges: dnsGroupIgnoreRanges,
+		},
+	}
+}
